# Mobirex backend — environment template.
# Copy to `.env` and fill in. `.env` itself is git-ignored and never committed.
# Every value below is a placeholder; no real credential appears in this repo.

DEBUG=0
SECRET_KEY=<django-secret-key>
ALLOWED_HOSTS=<api.example.com>
DJANGO_SETTINGS_MODULE=config.settings.prod

# PostgreSQL — `db` is the compose service name
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_HOST=db
DB_PORT=5432

# Redis — Celery broker and DRF throttle cache
REDIS_HOST=redis
REDIS_PORT=6379

# Shared secret for the landing-site contact form (constant-time compared)
SUPPORT_REQUEST_X_KEY=<random-32-byte-hex>

# Error reporting to Telegram. Left empty, the notifier is a silent no-op:
# reports are still written to the database, nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=False

# Support-request bot (separate bot, separate chat)
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# Admin panel base URL used to build links inside Telegram messages
CRM_BASE_URL=
