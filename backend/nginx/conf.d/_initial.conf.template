# Vaqtinchalik HTTP-only config (faqat install.sh ishlatadi)
# Certbot ACME challenge'ni o'tkazish uchun ishlatiladi.
# Cert olingach o'chiriladi, asosiy config'lar joyiga qaytariladi.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name mobirex.uz www.mobirex.uz api.mobirex.uz _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        add_header Content-Type text/plain;
        return 200 "mobirex bootstrap nginx — awaiting cert";
    }
}
